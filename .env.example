POSTGRES_DB=speech_asr
POSTGRES_USER=speech_asr
POSTGRES_PASSWORD=change-this-before-deploying
DATABASE_URL=postgresql://speech_asr:change-this-before-deploying@postgres:5432/speech_asr
API_PORT=8080
DATA_ROOT=/data
MODEL_ROOT=/models
WHISPER_MODEL=large-v3-turbo
INFERENCE_DEVICE=auto
